# App Configuration
APP_NAME=eToro Portfolio Manager
DEBUG=false
LOG_LEVEL=INFO
PORT=8000

# Database (SQLite for local dev)
DATABASE_URL=sqlite+aiosqlite:///./etoro_portfolio.db

# PostgreSQL (production — Render, etc.)
# Render provides a DATABASE_URL env var automatically; prefix with +asyncpg:
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/etoro_portfolio
# Or set POSTGRES_URL for the same effect (takes priority over DATABASE_URL)

# Security
SECRET_KEY=change-this-to-a-random-secret-key-in-production

# eToro API (legacy)
ETORO_API_KEY=
ETORO_USERNAME=

# eToro Public API (preferred — x-api-key + x-user-key)
# Generate UUID for every request is handled automatically by the client
ETORO_PUBLIC_API_KEY=
ETORO_USER_KEY=
# Set to true if your API keys are from the Virtual (demo) environment
ETORO_DEMO_MODE=false

# Set PAPER_TRADING=true to use simulated data when API keys are not configured
# Set PAPER_TRADING=false to use real eToro API data
PAPER_TRADING=true

# Claude AI
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# CORS — add production frontend URLs here
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://etorotradebot.leo-blixt77.workers.dev

# Risk Defaults
MAX_PORTFOLIO_DRAWDOWN=0.25
MAX_ALLOCATION_PER_TRADER=0.30
MIN_DIVERSIFICATION=3
COOLDOWN_DAYS_AFTER_LOSS=7
VOLATILITY_EXPOSURE_REDUCTION=0.50
